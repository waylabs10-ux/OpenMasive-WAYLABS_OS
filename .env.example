# ─────────────────────────────────────────────────────────────
# WhatsApp Bulk Sender — Variables de entorno
# Copia este archivo a `.env` y ajusta los valores.
# ─────────────────────────────────────────────────────────────

# URL del servidor de WhatsApp (OpenWA). El frontend hace proxy hacia aquí.
WA_SERVER_URL=http://localhost:3001

# Puerto del servidor Express + OpenWA
WA_SERVER_PORT=3001

# ID de sesión de OpenWA (carpeta donde se persiste la sesión)
WA_SESSION_ID=wa-bulk-sender

# Modo simulado: cuando es `true`, NO se inicia un navegador real ni OpenWA.
# Se simula el flujo completo (QR, conexión, envíos, bloqueos) para desarrollo
# y pruebas sin necesidad de un número de WhatsApp real.
# En producción ponlo en `false`.
WA_MOCK=true

# ─── Configuración anti-bloqueo (valores por defecto del rate limiter) ───
WA_MIN_DELAY_MS=8000
WA_MAX_DELAY_MS=25000
WA_BATCH_SIZE=30
WA_BATCH_PAUSE_MS=300000
WA_MAX_DAILY_MESSAGES=150
WA_TYPING_SIMULATION=true

# Clave de licencia OpenWA (opcional, para features avanzadas)
# OPENWA_LICENSE_KEY=
