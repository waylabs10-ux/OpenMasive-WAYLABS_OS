{
  "name": "openmasive-waylabs-os",
  "version": "1.0.0",
  "private": true,
  "description": "WhatsApp Bulk Sender — Next.js 14 + OpenWA con deduplicación y protección anti-bloqueo",
  "workspaces": [
    "wa-server"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "wa-server": "npm --workspace wa-server run start",
    "wa-server:dev": "npm --workspace wa-server run dev",
    "dev:all": "concurrently -n next,wa -c green,blue \"npm run dev\" \"npm run wa-server:dev\""
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "next": "14.2.18",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.18",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3"
  }
}
