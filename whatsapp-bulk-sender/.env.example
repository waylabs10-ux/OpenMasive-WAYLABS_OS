SESSION_NAME=bulk-sender
DELAY_MIN_MS=8000
DELAY_MAX_MS=20000

# false = ventana visible de Firefox (recomendado la 1ª vez)
HEADLESS=false

# 0 = esperar indefinidamente hasta escanear el QR
QR_TIMEOUT=0
AUTH_TIMEOUT=0

# Panel web (npm run web)
WEB_PORT=3847

# Bot de respuestas IA — Groq (console.groq.com)
AI_API_KEY=gsk_tu_clave_de_groq
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_MODEL=llama-3.3-70b-versatile
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=500

# Alternativa OpenAI:
# OPENAI_API_KEY=sk-...
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_MODEL=gpt-4o-mini

# Nota: FIREFOX_PATH no se usa. Playwright instala su propio Firefox con:
# npm run setup
