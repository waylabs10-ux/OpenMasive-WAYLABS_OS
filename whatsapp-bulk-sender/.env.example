SESSION_NAME=bulk-sender
DELAY_MIN_MS=8000
DELAY_MAX_MS=20000

# Primera vez: usa HEADLESS=false para ver el QR en Chromium
HEADLESS=false
USE_POPUP=true
POPUP_PORT=3000

# 0 = esperar indefinidamente hasta escanear el QR
QR_TIMEOUT=0
AUTH_TIMEOUT=0

# Solo activar en Docker/servidores Linux sin display
ENABLE_NO_SANDBOX=false
