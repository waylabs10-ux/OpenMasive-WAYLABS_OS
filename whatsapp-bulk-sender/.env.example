SESSION_NAME=bulk-sender
DELAY_MIN_MS=8000
DELAY_MAX_MS=20000

# Solo Firefox (Chrome/Chromium bloqueados)
# Ruta opcional si no se detecta automáticamente:
# FIREFOX_PATH=/usr/bin/firefox-esr

# false = ventana visible de Firefox (recomendado la 1ª vez)
HEADLESS=false

# 0 = esperar indefinidamente hasta escanear el QR
QR_TIMEOUT=0
AUTH_TIMEOUT=0
