{
  "name": "whatsapp-bulk-sender",
  "version": "1.1.0",
  "description": "Sistema de envío masivo de WhatsApp con Firefox, rate limiting y tracking SQLite",
  "main": "dist/index.js",
  "scripts": {
    "start": "ts-node src/index.ts",
    "build": "tsc",
    "start:prod": "node dist/index.js",
    "setup": "npx playwright install firefox",
    "postinstall": "npx playwright install firefox"
  },
  "dependencies": {
    "@wppconnect/wa-js": "^3.19.3",
    "@wppconnect/wa-version": "^1.5.0",
    "better-sqlite3": "^9.6.0",
    "dotenv": "^16.4.5",
    "papaparse": "^5.4.1",
    "playwright": "^1.52.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "@types/papaparse": "^5.3.14",
    "@types/qrcode-terminal": "^0.12.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  }
}
